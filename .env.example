ATLAS_DOMAIN=atlas.example.org
ACME_EMAIL=admin@example.org
ATLAS_UPLOAD_TOTAL_MB=2048
ATLAS_WEB_PUSH_ENABLED=0
ATLAS_WEB_PUSH_SUBJECT=mailto:admin@example.org
# Opt-in: set /app/backups and enable the Compose 'backups' profile.
ATLAS_BACKUP_DIR=
ATLAS_BACKUP_INTERVAL_HOURS=24
ATLAS_BACKUP_KEEP=7
ATLAS_BACKUP_SNAPSHOT_TIMEOUT_SECONDS=30
ATLAS_BACKUP_VERIFY_TIMEOUT_SECONDS=600
